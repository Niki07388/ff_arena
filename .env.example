# ============================================================
#  Copy this file to `.env` and fill in your own values.
#  `.env` is git-ignored — never commit real credentials.
# ============================================================

# Supabase project settings → API
# The publishable/anon key is safe to ship in the browser bundle ONLY because
# Row Level Security is enabled. Run `supabase/schema.sql` before going live.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy alias — only needed if your project still uses the older anon key format.
# VITE_SUPABASE_ANON_KEY=
